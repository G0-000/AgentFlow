# ===== macOS 系统文件 =====
.DS_Store

# ===== Python / uv（后端 backend/） =====
# Python 虚拟环境目录
.venv/
backend/.venv/
# Python 缓存与编译产物
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# uv 锁文件：本地产物，不入库（依赖声明看 pyproject.toml，装包时自动重新生成）
backend/uv.lock

# ===== Node / pnpm（前端） =====
# 依赖安装目录（凭 package.json + pnpm-lock.yaml 可重新生成）
node_modules/
# 构建产物（凭源码可重新构建）
dist/
build/
*.tsbuildinfo

# ===== 本地配置 =====
# 本地配置文件，含环境相关配置，不入库
config.yaml
# config.example.yaml 是配置模板，保留入库（上面的规则不影响它）

# ===== 环境变量 =====
# 本地环境变量文件，可能含密钥，不入库
.env
.env.*
# .env.example 是模板，保留入库
!.env.example

# ===== 日志 =====
*.log
logs/

# ===== 编辑器 / IDE =====
.vscode/
.idea/
